{
  "name": "cnwl-community-navigator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/serve.mjs",
    "check": "node --test tests/unit/*.test.mjs",
    "test": "playwright test",
    "test:a11y": "playwright test tests/accessibility.spec.js",
    "test:report": "playwright show-report",
    "deploy:api": "wrangler deploy --config navigator/wrangler.jsonc",
    "verify:monitoring": "node scripts/verify-monitoring.mjs"
  },
  "dependencies": {
    "@sentry/browser": "11.9.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "esbuild": "0.28.2",
    "jsdom": "30.1.3",
    "wrangler": "4.152.0"
  }
}
